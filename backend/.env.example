# 백엔드 환경변수. 실제 .env는 커밋하지 않는다(시크릿은 backend에만 — CONTEXT.md).

# AWS RDS(PostgreSQL) 접속 URL. psycopg v3 드라이버. 로컬은 당분간 Homebrew 네이티브 Postgres
# (docker 미설치 — 추후 Docker 재도입 시 docker-compose.yml의 db 서비스로 되돌린다, README 참고).
DATABASE_URL=postgresql+psycopg://nabi:nabi@localhost:5432/nabi

# 명단 원본 보관 S3(OP-002 roster import). 미설정이면 원본 박제 생략(로컬/CI는 비워둠).
#   자격증명은 boto3 기본 체인(IAM 역할/AWS_* 환경변수)에서 해결한다.
# S3_BUCKET=nabi-roster-originals
# AWS_REGION=ap-northeast-2

# 운영자 가드·데모 자격증명 활성 토글. 기본 cognito=fail-closed(실 Cognito JWKS 어댑터 미구현이라
# 로그인·어드민 가드가 명확히 실패). 로컬/데모는 demo로 — 데모 자격증명·운영자 스텁이 켜진다.
# AUTH_BACKEND=demo

# 알림 이메일 채널. 기본 fake(기록만). 실발송은 smtp + 자격증명(없으면 생성 시점 실패).
# EMAIL_BACKEND=fake
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASSWORD= / SMTP_FROM=

# 알림 10분 리마인더 폴링 스케줄러. 기본 off — 로컬에서 의도치 않게 돌지 않게 명시 토글.
# SCHEDULER_ENABLED=false

# 동시성 상한(행사 당일 대비). 아래는 기본값이라 생략해도 된다 — 각 값의 근거는 app/config.py 주석.
# DB_POOL_SIZE=10 / DB_MAX_OVERFLOW=40 / DB_POOL_TIMEOUT=10 / DB_POOL_PRE_PING=true
# OpenAI 응답 대기(초) — 러브콜 초안 / 텍스트 메모 구조화 / 녹음 전사 + 전사 작업 안의 구조화(연결은 늘 5초)
# OPENAI_CHAT_TIMEOUT_SECONDS=60 / OPENAI_STRUCTURING_TIMEOUT_SECONDS=180 / OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=300
# OpenAI 재시도(호출 종류별) — 러브콜 초안 / 구조화(텍스트·전사 작업 안 둘 다) / 오디오 전사 호출
# OPENAI_CHAT_MAX_RETRIES=1 / OPENAI_STRUCTURING_MAX_RETRIES=0 / OPENAI_TRANSCRIPTION_MAX_RETRIES=1
# TRANSCRIPTION_MAX_CONCURRENCY=3 / TRANSCRIPTION_MAX_UPLOAD_BYTES=26214400
# TRANSCRIPTION_JOB_MAX_AGE_SECONDS=900(대기열에서 이보다 오래 기다린 작업은 OpenAI 호출 없이 실패 —
#   화면 폴링 1800초 − 작업 최악 실행 900초. 산정은 app/config.py 주석)
# TRANSCRIPTION_FAIL_ORPHANS_ON_STARTUP=true(시작 시 이전 프로세스의 pending 작업 정리 — 백엔드 프로세스 1개 전제)
# AI 채팅(텍스트 구조화·러브콜 초안) 동시 호출 자리 / 자리 대기(초) / 대기 상한(이미 이만큼 기다리면 즉시 503 ai_busy)
# AI_CHAT_MAX_CONCURRENCY=6 / AI_CHAT_ACQUIRE_TIMEOUT_SECONDS=5 / AI_CHAT_MAX_WAITERS=8
# 녹음 업로드(S3 전송) 동시 처리 자리 / 자리 대기(초) / 대기 상한(이미 이만큼 기다리면 즉시 503 ai_busy)
# TRANSCRIPTION_MAX_CONCURRENT_UPLOADS=4 / TRANSCRIPTION_UPLOAD_ACQUIRE_TIMEOUT_SECONDS=15 / TRANSCRIPTION_UPLOAD_MAX_WAITERS=5
# 비밀번호 해시(bcrypt) 동시 실행 자리 / 자리 대기(초) / 대기 상한(이미 이만큼 기다리면 즉시 503)
# PASSWORD_HASH_MAX_CONCURRENCY=2 / PASSWORD_HASH_ACQUIRE_TIMEOUT_SECONDS=10 / PASSWORD_HASH_MAX_WAITERS=12
# 스레드 예산(자리 + 대기 상한 = 그 자리에 묶일 수 있는 요청 스레드, 전체 40개): 해시 2+12=14 / 채팅 6+8=14 /
#   업로드 4+5=9 → 합 37. 셋이 동시에 가득 차도 3개 이상이 남는다. 이 값들을 올릴 때는 합이 40 아래로 남는지
#   같이 본다(app/config.py 주석).
# SMTP_TIMEOUT_SECONDS=8 / EMAIL_MAX_PER_SECOND=10

# (이후 슬라이스) Cognito / Claude API — 인증·AI 시크릿은 여기에만 둔다.
